datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  department String
  role       String
  status     String   @default("Active")
  avatarColor String  @default("#6366f1")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("employees")
}

model FileUpload {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  s3Key        String
  createdAt    DateTime @default(now())

  @@map("file_uploads")
}
